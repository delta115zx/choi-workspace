    {
      "cell_type": "code",
      "source": [
        "# %pip install mlflow\n",
        "import numpy as np\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "import mlflow\n",
        "\n",
        "mlflow.start_run()\n",
        "\n",
        "featuree = np.array([[80, 20], [95, 5], [10, 90], [90, 10], [5, 95]])\n",
        "labell = np.array([\"액션\", \"액션\", \"조폭\", \"액션\", \"조폭\"])\n",
        "\n",
        "knc = KNeighborsClassifier(3) \n",
        "knc.fit(featuree, labell)\n",
        "\n",
        "fight = 30\n",
        "yok = 70\n",
        "z = np.array([[fight, yok]])\n",
        "result = knc.predict(z)\n",
        "print(result[0])\n",
        "\n",
        "mlflow.sklearn.save_model(sk_model=knc, path=\"./kwonKNNModel\")\n",
        "\n",
        "mlflow.end_run()"
      ],
      "outputs": [
        {
