# ── Azure OpenAI (핵심 — 전 에이전트 공통) ─────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5-nano
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── DB 사용자이름 비밀번호 주소 ────────────────────────────────
ORACLE_USER=<your-user>
ORACLE_PASSWORD=<your-password>
ORACLE_DSN=<your-dsn>   # host:port/service_name

# ── 소상공인 상가정보 API (fetch_sclscode.py) ────────────────
# 발급: https://www.data.go.kr → B553077/api/open/sdsc2
SGNG_API_KEY=<your-api-key>

# ── Kakao REST API (분식 타입 분류 스크립트) ─────────────────
# 발급: https://developers.kakao.com → 내 애플리케이션 → REST API 키
KAKAO_REST_KEY=<your-kakao-rest-api-key>
